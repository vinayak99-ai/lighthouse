# Set ONE of these to go live. Without either, the server falls back to a
# deterministic keyword-based router (src/chat/fallbackRouter.js) so the app
# still runs end-to-end with no external dependency.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# If both keys above are set, Anthropic wins by default. Force a specific
# provider with:
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic

# Optional overrides.
PORT=8787
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o

# --- Data source -----------------------------------------------------------
# Without SNOWFLAKE_ACCOUNT set, the app queries the bundled SQLite stub
# dataset (server/src/data/lighthouse.sqlite). Set it to point the exact same
# 10 tools at a real Snowflake warehouse instead -- see
# server/src/data/snowflakeSetup.sql for the one-time read-only role/
# warehouse/resource-monitor setup this expects, and README.md's
# "Connecting to real Snowflake" section for the full picture.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=LIGHTHOUSE_READONLY
SNOWFLAKE_WAREHOUSE=LIGHTHOUSE_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Force a specific data source regardless of whether SNOWFLAKE_ACCOUNT is set:
# LIGHTHOUSE_DATA_SOURCE=snowflake
# LIGHTHOUSE_DATA_SOURCE=sqlite

# How long Snowflake itself will let one query run before aborting it
# server-side (ALTER SESSION STATEMENT_TIMEOUT_IN_SECONDS). The app also
# enforces its own timeout ~5s past this as a backstop.
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=60
